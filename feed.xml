---
layout: null
permalink: /feed.xml
---
<?xml version="1.0" encoding="UTF-8"?>
<rss version="2.0" xmlns:atom="http://www.w3.org/2005/Atom">
  <channel>
    <title>{{ site.title | xml_escape }}</title>
    <description>{{ site.description | xml_escape }}</description>
    <link>{{ '/' | absolute_url }}</link>
    <language>mul</language>
    <atom:link href="{{ '/feed.xml' | absolute_url }}" rel="self" type="application/rss+xml"/>
    {% assign stories = site.ru_posts | concat: site.uk_posts | concat: site.en_posts | sort: 'date' | reverse %}
    {% for p in stories limit: 100 %}
    <item>
      <title>{{ p.title | xml_escape }}</title>
      <description>{% if p.description %}{{ p.description | xml_escape }}{% else %}{{ p.excerpt | strip_html | truncatewords: 60 | xml_escape }}{% endif %}</description>
      <link>{{ p.url | absolute_url }}</link>
      <guid isPermaLink="true">{{ p.url | absolute_url }}</guid>
      <pubDate>{{ p.date | date_to_rfc822 }}</pubDate>
    </item>
    {% endfor %}
  </channel>
</rss>
